# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Database: unset (or "sqlite") uses local SQLite for zero-config dev.
# Set DB_DIALECT=mssql to use Azure SQL Database instead.
DB_DIALECT=
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=your-database-name
AZURE_SQL_USER=your-admin-username
AZURE_SQL_PASSWORD=your-admin-password

# Storage: "local" for dev, "azure" for Azure Blob Storage in production
STORAGE_DRIVER=local

# --- Only needed if STORAGE_DRIVER=azure ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# Metered.ca Open Relay - free TURN relay service so video/audio calls work across
# restrictive NATs/firewalls (e.g. different countries or mobile networks) where a
# direct STUN-only peer connection fails. Sign up free at metered.ca/tools/openrelay.
# Leave blank to fall back to STUN-only.
METERED_API_KEY=
METERED_SUBDOMAIN=

# Gmail SMTP - sends the signup verification code email. Requires 2-Step Verification
# enabled on the Gmail account, then generate an "App Password" (not your normal
# password) from Google Account > Security > App Passwords. Leave blank to skip real
# email sending - the code will just be printed to the backend console instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Secret code required to self-register an admin account via the public signup form.
# Keep this private - anyone who has it can grant themselves full admin control.
# Leave blank to disable admin self-signup entirely (admins can still be created by
# promoting an existing user's role from the Admin dashboard).
ADMIN_INVITE_CODE=
